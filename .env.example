# ─────────────────────────────────────────────────────────────
# taxi-monitor — userbot, который ловит заказы такси в чатах
# и складывает их в отдельный канал (не в «Избранное»).
#
# Заполнить и сохранить как .env рядом с run.py
# ─────────────────────────────────────────────────────────────

# 1) Данные приложения с https://my.telegram.org  →  API development tools
#    Это НЕ токен бота. Это api_id/api_hash приложения.
API_ID=123456
API_HASH=0123456789abcdef0123456789abcdef

# 2) Строка сессии аккаунта (получается один раз через `python tools/login.py`)
SESSION_STRING=
SESSION_NAME=./data/taxi_monitor

# 3) Куда складывать найденные заказы.
#    auto          — бот сам создаст приватный канал «🚕 Заказы такси» (по умолчанию)
#    @username     — существующий канал/группа, где аккаунт админ
#    -100123456789 — числовой ID канала
NOTIFY_TO=auto

#    Заголовок перед каждым заказом. Пусто = без заголовка.
NOTIFY_HEADER=🚕 Новый заказ

#    Добавлять строку «Источник: <название чата>» после заголовка.
INCLUDE_SOURCE=true

# 4) Что мониторим. Через запятую: @username, ссылки t.me/..., числовые ID.
#    Пусто = все чаты, в которых состоит аккаунт.
MONITOR_CHATS=

# 5) Триггеры
#    Минимальный скор, чтобы сообщение считалось заказом.
#    Скор = сильные триггеры*2 + структурные признаки*1
MIN_SCORE=2
#    Пересылать сообщения, написанные ботами (у некоторых чатов есть бот-агрегатор)
ALLOW_BOTS=false
#    Игнорировать сообщения короче N символов
MIN_LENGTH=15

# 6) Антидубли: одинаковая заявка не чаще, чем раз в N секунд
DEDUPE_TTL=900
#    Пауза между пересылками в секунду (антифлуд Telegram)
SEND_DELAY=1.5

# 7) Отладка
#    true — ничего не отправлять, только писать в лог (безопасный прогон)
DRY_RUN=false
LOG_LEVEL=INFO
